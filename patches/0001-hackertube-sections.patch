+    /**
+     * HackerTube video: fetch hackertube.org's related videos in parallel with YouTube's metadata.
+     * The row is pinned to the top of the suggestions whenever it arrives, and drives autoplay.
+     */
+    private void loadHackerTubeUpNext(Video video) {
+        String videoId = video != null ? video.videoId : null;
+        boolean isHackerTube = video != null && (HackerTubeService.isHackerTubeVideo(videoId)
+                || video.mediaItem instanceof com.liskovsoft.smartyoutubetv2.common.hackertube.HtMediaItem);
+
+        // The player asks for suggestions several times while a video starts. Don't restart (and so
+        // never finish) the request for the same video; reuse what's loaded or still loading.
+        if (isHackerTube && Helpers.equals(videoId, mHtVideoId)
+                && (mHtUpNext != null || RxHelper.isAnyActionRunning(mHtRelatedAction))) {
+            return;
+        }
+
+        RxHelper.disposeActions(mHtRelatedAction);
+        mHtUpNext = null;
+        mHtNextVideo = null;
+        mHtVideoId = null;
+
+        android.util.Log.i("HackerTube", "up next: video=" + videoId + " hackertube=" + isHackerTube);
+
+        if (!isHackerTube) {
+            return;
+        }
+
+        mHtVideoId = videoId;
+        mHtRelatedAction = HackerTubeService.getRelatedObserve(videoId)
+                .subscribe(
+                        group -> {
+                            Video current = getVideo();
+                            if (current == null || !Helpers.equals(current.videoId, videoId)) {
+                                android.util.Log.i("HackerTube", "up next: skipped, player moved on from " + videoId);
+                                return;
+                            }
+                            mHtUpNext = VideoGroup.from(group);
+                            mHtUpNext.setPosition(0); // top of the suggestions
+                            appendHackerTubeUpNextIfNeeded(current);
+                            android.util.Log.i("HackerTube", "up next: shown for " + videoId + ", autoplay -> "
+                                    + (mHtNextVideo != null ? mHtNextVideo.videoId : "none"));
+                        },
+                        error -> android.util.Log.w("HackerTube", "related failed: " + videoId + ": " + error.getMessage())
+                );
+    }
+
+    private void appendHackerTubeUpNextIfNeeded(Video video) {
+        if (getPlayer() == null || mHtUpNext == null || mHtUpNext.isEmpty()) {
+            return;
+        }
+
+        getPlayer().updateSuggestions(mHtUpNext);
+        mBrowseProcessor.process(mHtUpNext);
+
+        // Autoplay: first related video that isn't this one and hasn't been watched yet
+        mHtNextVideo = null;
+        for (Video candidate : mHtUpNext.getVideos()) {
+            if (candidate != null && candidate.hasVideo() && !Helpers.equals(candidate.videoId, video.videoId)
+                    && !HackerTubeService.isWatched(getContext(), candidate.videoId)) {
+                mHtNextVideo = candidate;
+                break;
+            }
+        }
+
+        if (mHtNextVideo != null && mNextSectionVideo == null) {
+            getPlayer().setNextTitle(mHtNextVideo);
+        }
+    }
