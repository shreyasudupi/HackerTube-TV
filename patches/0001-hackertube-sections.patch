+        mBrowseProcessor.process(mHtUpNext);
+
+        // Autoplay: first related video that isn't this one and hasn't been watched yet
+        mHtNextVideo = null;
+        for (Video candidate : mHtUpNext.getVideos()) {
+            if (candidate != null && candidate.hasVideo() && !Helpers.equals(candidate.videoId, video.videoId)
+                    && !HackerTubeService.isWatched(getContext(), candidate.videoId)) {
+                mHtNextVideo = candidate;
+                break;
+            }
+        }
+
+        if (mHtNextVideo != null && mNextSectionVideo == null) {
+            getPlayer().setNextTitle(mHtNextVideo);
+        }
+    }
